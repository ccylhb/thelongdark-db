---
import Base from "../layouts/Base.astro";
import Related from "../components/Related.astro";
import food from "../data/thelongdark_food.json";

const pct = (v: any) => {
  const m = String(v ?? "").match(/\((\d+(?:\.\d+)?)%\)/);
  return m ? parseFloat(m[1]) : 0;
};
const num1 = (v: any) => {
  const m = String(v ?? "").match(/-?\d+(?:\.\d+)?/);
  return m ? parseFloat(m[0]) : 0;
};
const items = food
  .map((x) => ({
    slug: x.slug,
    name: x.title,
    calories: num1(x.fields?.calories),
    hydration: num1(x.fields?.hydration),
    vitaminc: pct(x.fields?.vitaminc),
    weight: num1(x.fields?.weight),
    icon: x.icon_file || "",
  }))
  .filter((x) => x.calories > 0 || x.hydration !== 0)
  .sort((a, b) => a.name.localeCompare(b.name));
---
<Base
  title="The Long Dark Calorie Calculator — plan calories, hydration & vitamin C"
  description="Pick The Long Dark food items and see total calories, hydration, vitamin C and carried weight — avoid scurvy and starvation in your browser."
>
  <h1>Calorie Calculator</h1>
  <p class="muted">Pick what you plan to eat — totals update live. A character needs roughly <strong>2,500–3,000 kcal/day</strong> at normal activity (more when harvesting or climbing), and vitamin C below ~1% per day risks scurvy on long runs.</p>

  <div class="grid grid-2" style="margin:1rem 0">
    <div class="card">
      <strong>1 · Pick items</strong>
      <input id="q" type="search" placeholder="Filter food..." style="width:100%;max-width:320px;margin:0.5rem 0" />
      <select id="pick" size="12" style="width:100%">
        {items.map((x) => <option value={x.slug}>{x.name} ({x.calories} kcal / {x.hydration}%)</option>)}
      </select>
      <button id="add" style="margin-top:0.5rem">Add →</button>
    </div>
    <div class="card">
      <strong>2 · Your daily plan</strong>
      <ul id="plan" style="min-height:180px"></ul>
      <div class="stat-row" style="margin-top:0.75rem">
        <div><div class="stat-num" id="tCal">0</div><div class="stat-label">Calories (kcal)</div></div>
        <div><div class="stat-num" id="tHyd">0</div><div class="stat-label">Hydration (%)</div></div>
        <div><div class="stat-num" id="tVit">0</div><div class="stat-label">Vitamin C (%)</div></div>
        <div><div class="stat-num" id="tWt">0</div><div class="stat-label">Weight (kg)</div></div>
      </div>
      <p id="verdict" class="muted" style="margin-top:0.5rem"></p>
      <button id="clear" style="background:var(--bg-soft);color:var(--text);border:1px solid var(--border)">Clear</button>
    </div>
  </div>

  <script define:vars={{ items }}>
    const plan = [];
    const bySlug = Object.fromEntries(items.map((x) => [x.slug, x]));
    const q = document.getElementById("q");
    const pick = document.getElementById("pick");
    const listEl = document.getElementById("plan");
    const tC = document.getElementById("tCal");
    const tH = document.getElementById("tHyd");
    const tV = document.getElementById("tVit");
    const tW = document.getElementById("tWt");
    const verdict = document.getElementById("verdict");
    const render = () => {
      listEl.innerHTML = plan.map((s, i) => {
        const it = bySlug[s];
        return `<li>${it.name} — ${it.calories} kcal, ${it.hydration}% hydration, ${it.vitaminc}% vit C <button data-i="${i}" style="padding:0 0.4rem;font-size:0.75rem">×</button></li>`;
      }).join("");
      const c = plan.reduce((a, s) => a + bySlug[s].calories, 0);
      const h = plan.reduce((a, s) => a + bySlug[s].hydration, 0);
      const v = plan.reduce((a, s) => a + bySlug[s].vitaminc, 0);
      const w = plan.reduce((a, s) => a + bySlug[s].weight, 0);
      tC.textContent = c; tH.textContent = Math.round(h * 10) / 10; tV.textContent = Math.round(v * 10) / 10; tW.textContent = Math.round(w * 100) / 100;
      const msgs = [];
      if (c < 2500) msgs.push("Below a normal day's calories (~2,500 kcal) — add more.");
      else msgs.push("✓ Covers a normal activity day.");
      if (v > 0 && v < 1) msgs.push("⚠ Vitamin C is very low — scurvy risk on long runs.");
      else if (v >= 1) msgs.push("✓ Vitamin C covered.");
      if (h < 0) msgs.push("⚠ Net dehydration — pack water or drinks.");
      verdict.textContent = msgs.join(" ");
      listEl.querySelectorAll("button").forEach((b) =>
        b.addEventListener("click", () => { plan.splice(+b.dataset.i, 1); render(); }));
    };
    document.getElementById("add").addEventListener("click", () => {
      if (pick.value) { plan.push(pick.value); render(); }
    });
    document.getElementById("clear").addEventListener("click", () => { plan.length = 0; render(); });
    const filter = () => {
      const v = q.value.trim().toLowerCase();
      Array.from(pick.options).forEach((o) => {
        o.hidden = v && !o.textContent.toLowerCase().includes(v);
      });
    };
    q.addEventListener("input", filter);
    render();
  </script>

  <Related
    links={[
      { href: "/food/", title: "Food & Drink", sub: "All food values" },
      { href: "/rankings/", title: "Rankings", sub: "Best calorie & warmth picks" },
      { href: "/clothing/", title: "Clothing", sub: "Warmth values" },
    ]}
  />
</Base>
