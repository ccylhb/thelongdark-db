---
const SITE = Astro.site?.origin ?? "";
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import EntryStats from "../../components/EntryStats.astro";
import firstaid from "../../data/thelongdark_firstaid.json";
import mesh from "../../data/mesh.json";
import { introHtml } from "../../lib/mesh";

export function getStaticPaths() {
  return firstaid.map((x: any) => ({ params: { slug: x.slug }, props: { x } }));
}

const { x } = Astro.props as any;
const f = x.fields || {};
const ihtml = introHtml(x.intro, mesh, x.title);
const __slug = Astro.params.slug;
const __ld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
      { "@type": "ListItem", position: 2, name: "Firstaid", item: SITE + "/firstaid/" },
      { "@type": "ListItem", position: 3, name: x.title },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: x.title,
    description: (x.intro || "").slice(0, 160),
    mainEntityOfPage: SITE + "/firstaid/" + __slug + "/",
  },
];
---
<Base
  title={`${x.title} — The Long Dark first aid stats (${f.weight || "?"} kg)`}
  description={`${x.title}: ${f.weight || "?"} kg${f["unit name"] ? `, ${f["unit count"] || "?"} ${f["unit name"]}(s)` : ""} — The Long Dark medical item values and uses.`}
>
  <h1 class="icon-h1">
    {x.icon_file ? <img src={`/icons/${x.icon_file}`} alt={x.title} loading="eager" /> : null}
    <span>{x.title}</span>
  </h1>
  <EntryStats entry={x} keys={["weight", "unit count", "unit name", "item type"]} labels={{ weight: "Weight (kg)", "unit count": "Units per pack", "unit name": "Unit", "item type": "Type" }} />
  {ihtml && <p set:html={ihtml}></p>}
  <Related
    links={[
      { href: "/firstaid/", title: "All First Aid", sub: "Medical items table" },
      { href: "/afflictions/", title: "Afflictions", sub: "Conditions & treatments" },
      { href: "/search/", title: "A–Z Index", sub: "Every entry" },
    
      { href: "/rankings/", title: "Rankings", sub: "Best picks" },
    ]}
  />
<script is:inline type="application/ld+json" set:html={JSON.stringify(__ld)}></script>
</Base>
