---
// Reusable AdSense ad unit. Drop into any layout once the client ID is set.
// Usage: <AdSlot slot="1234567890" format="auto" />
interface Props {
  slot: string;
  format?: "auto" | "horizontal" | "vertical" | "rectangle";
  client?: string;
}
import site from "../../site.config.json";
const { slot, format = "auto", client = site.adsenseClientId } = Astro.props;
---

<div class="ad-slot" data-ad-slot={slot}>
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client={client}
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive="true"
  ></ins>
</div>
<script is:inline set:html={`(window.adsbygoogle = window.adsbygoogle || []).push({});`}></script>

<style is:global>
  .ad-slot {
    min-height: 90px;
    margin: 1.5rem 0;
    overflow: hidden;
  }
  .ad-slot ins.adsbygoogle[data-ad-status="unfilled"] {
    display: none !important;
  }
</style>
